<?xml version="1.0" encoding="utf-8"?>
<!-- Edizione completa: si aggiunge al manifest principale. Questi elementi fanno bloccare
     da Play Protect gli APK scaricati dal browser: installare via ADB. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- «Dov'è?» dal portale anche con l'app non in primo piano; chiesto solo se lo si attiva. Le altre
         edizioni mandano la posizione attuale se la Home è aperta, altrimenti l'ultima nota. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <application>
        <service
            android:name=".phone.BadgeListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".remote.SmsCommandReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />
    </application>
</manifest>
