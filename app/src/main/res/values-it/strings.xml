    <string name="phone_title">Suoneria e avvisi</string>
    <string name="phone_ringer_lock">Suoneria protetta</string>
    <string name="phone_ringer_lock_detail">Se il telefono viene messo in silenzioso o il volume si abbassa, torna al livello scelto. Vale anche per le sveglie dei promemoria.</string>
    <string name="phone_min_volume">Volume minimo</string>
    <string name="phone_battery">Batteria scarica</string>
