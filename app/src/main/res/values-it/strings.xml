    <string name="protection_release_confirm">Rimuovere il Device Owner?</string>
    <string name="protection_release_text">Tutte le protezioni avanzate vengono tolte. Per riattivarle servirà ripristinare il telefono e rifare il comando adb.</string>
    <string name="protection_remove">Rimuovi</string>
