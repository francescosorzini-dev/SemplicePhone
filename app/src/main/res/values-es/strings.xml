    <string name="protection_title">Protección</string>
    <string name="protection_always">Siempre activo: sin arrastrar ni desinstalar desde el inicio, botón Atrás desactivado, doble toque ignorado, ajustes protegidos con PIN.</string>
    <string name="protection_advanced">Protección avanzada (Device Owner)</string>
    <string name="protection_how">Para bloquear la barra de notificaciones, las instalaciones y el restablecimiento, SemplicePhone debe ser propietario del dispositivo. Se hace una vez, desde un ordenador, en un teléfono recién restablecido y sin cuentas de Google:</string>
    <string name="protection_after">Después del comando se pueden añadir cuentas con normalidad.</string>
    <string name="protection_check_again">Comprobar de nuevo</string>
    <string name="protection_is_owner">SemplicePhone es propietario del dispositivo</string>
    <string name="protection_release">Quitar Device Owner</string>
    <string name="protection_release_confirm">¿Quitar el Device Owner?</string>
    <string name="protection_release_text">Se quitarán todas las protecciones avanzadas. Para reactivarlas habrá que restablecer el teléfono y repetir el comando adb.</string>
    <string name="protection_remove">Quitar</string>
