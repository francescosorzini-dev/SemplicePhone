    <string name="type_messages_unread">Mensajes sin leer</string>
    <string name="label_messages_unread">Mensajes nuevos</string>
    <string name="messages_none">Ningún mensaje por leer</string>
    <string name="messages_spoken_count">Mensajes por leer: %1$d</string>
    <string name="messages_spoken_one">%1$s, en %2$s: %3$s</string>
    <string name="tile_messages_hint">Muestra los mensajes recibidos y aún no leídos (SMS, WhatsApp, Telegram…): un toque abre esa conversación, una pulsación larga lo lee en voz alta. Hace falta el acceso a las notificaciones.</string>
    <string name="tile_messages_hint_basic">En la versión de Google Play el mosaico abre la app Mensajes. La lista de mensajes por leer está en las ediciones Estándar y Completa.</string>
    <string name="tile_own_photo">Foto del familiar (opcional)</string>
    <string name="prot_no_lock">Sin pantalla de bloqueo</string>
    <string name="prot_no_lock_detail">Al encender la pantalla se llega directamente al inicio. Solo funciona si el teléfono no tiene PIN, patrón ni contraseña.</string>
    <string name="phone_night">Noche tranquila</string>
    <string name="phone_night_detail">De noche las llamadas llegan sin sonar, salvo las de los números SOS (la familia). Hace falta el rol de filtro de llamadas.</string>
    <string name="phone_night_from">Desde</string>
    <string name="phone_night_to">Hasta</string>
    <string name="phone_charge">«Ponga a cargar» por la noche</string>
    <string name="phone_charge_detail">A la hora elegida, si la batería está baja y no se está cargando, lo dice en voz alta y a pantalla completa. Lo repite una hora después.</string>
    <string name="phone_charge_time">Hora</string>
    <string name="phone_charge_below">Si la batería está por debajo de</string>
    <string name="charge_title">Ponga el teléfono a cargar</string>
    <string name="charge_text">La batería está al %1$d%%. Conecte el cargador antes de ir a dormir.</string>
    <string name="notice_ok">OK</string>
    <string name="phone_hold">Abrir los mosaicos manteniendo pulsado</string>
    <string name="phone_hold_detail">Contra los toques involuntarios (temblor): un mosaico se abre solo manteniéndolo pulsado un momento; un toque breve dice el nombre.</string>
    <string name="phone_theme">Apariencia</string>
    <string name="phone_theme_normal">Normal</string>
    <string name="phone_theme_contrast">Alto contraste</string>
    <string name="phone_theme_night">Oscuro por la noche (21–7)</string>
    <string name="hold_hint">Mantenga pulsado para abrir</string>
    <string name="backup_title">Copia de seguridad</string>
    <string name="backup_close">Cerrar</string>
    <string name="backup_intro">En cada guardado el teléfono conserva una copia (las 10 últimas). También puede exportarlo todo a un archivo, fotos incluidas, para pasarlo a otro teléfono. Al restaurar, la copia se abre aquí: luego pulse Guardar.</string>
