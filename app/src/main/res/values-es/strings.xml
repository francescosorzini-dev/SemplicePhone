    <string name="phone_ringer_lock">Tono protegido</string>
    <string name="phone_ringer_lock_detail">Si el teléfono se pone en silencio o se baja el volumen, vuelve al nivel elegido. También vale para las alarmas de los recordatorios.</string>
    <string name="phone_min_volume">Volumen mínimo</string>
