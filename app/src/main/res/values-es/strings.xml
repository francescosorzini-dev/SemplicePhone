    <string name="tile_radio_add">+ Añadir emisora</string>
    <string name="special_badges_restricted">Si el interruptor está en gris: Ajustes › Aplicaciones › SemplicePhone › menú ⋮ arriba › «Permitir ajustes restringidos», y vuelva aquí.</string>
    <string name="label_album">Álbum</string>
    <string name="album_folders">Carpetas del teléfono</string>
    <string name="album_folders_hint">Las fotos y vídeos de las carpetas elegidas y de todas sus subcarpetas (p. ej. DCIM, WhatsApp › Media) aparecen solos, también los nuevos. Se omiten las fotos enviadas desde WhatsApp y las carpetas ocultas.</string>
    <string name="album_folder_other_phone">carpeta de otro teléfono (aquí no se lee)</string>
    <string name="album_add_folder">+ Añadir una carpeta</string>
    <string name="video_error">Este vídeo no se puede ver.</string>
    <string name="video_again">OTRA VEZ</string>
    <string name="video_close">CERRAR</string>
    <string name="message_seen">LO HE VISTO</string>
    <string name="message_seen_event">Videomensaje visto: «%1$s»</string>
    <string name="tpl_title">Plantillas listas</string>
    <string name="tpl_lead">Elige la situación más parecida: ajusta mosaicos y opciones. Familiares, SOS, recordatorios, tiempo y álbum se mantienen. Después se puede cambiar todo.</string>
    <string name="tpl_autonomous">Autónomo</string>
    <string name="tpl_autonomous_desc">Ya usa bien el teléfono: WhatsApp, mensajes sin leer, cámara, álbum, búsqueda de apps, internet.</string>
    <string name="tpl_calls">Solo llamadas</string>
    <string name="tpl_calls_desc">Mosaicos grandes para llamar a la familia, llamadas perdidas y SOS. Respuesta automática, quien llama dicho en voz alta, desconocidos bloqueados.</string>
    <string name="tpl_memory">Memoria frágil</string>
    <string name="tpl_memory_desc">Pocos mosaicos con las fotos para llamar y el álbum. Se abre manteniendo pulsado, noche tranquila, «ponga a cargar», respuesta automática, desconocidos bloqueados.</string>
    <string name="tpl_sight">Poca vista</string>
    <string name="tpl_sight_desc">Mosaicos más altos, alto contraste, nombres de los mosaicos y de quien llama en voz alta.</string>
    <string name="tpl_hearing">Poco oído</string>
    <string name="tpl_hearing_desc">Videollamadas, mensajes escritos y mensajes sin leer; altavoz en las llamadas.</string>
    <string name="tpl_tremor">Manos temblorosas</string>
    <string name="tpl_tremor_desc">Mosaicos más altos que solo se abren manteniéndolos pulsados, confirmación por voz, respuesta automática.</string>
    <string name="tpl_skip_first">Empezar con la pantalla básica</string>
    <string name="tpl_back">Atrás</string>
    <string name="tpl_apply">Usar esta plantilla</string>
    <string name="tpl_confirm">La disposición de los mosaicos se sustituye. Familiares, SOS, recordatorios, tiempo y álbum se mantienen. Hasta que pulses Guardar puedes volver atrás.</string>
    <string name="tile_wa_not_found">WhatsApp aún no tiene la videollamada para este número: guárdalo en contactos, abre WhatsApp y actualiza los contactos (Nuevo chat › ⋮ › Actualizar). Mientras tanto, el mosaico abre el chat.</string>
    <string name="type_tg_video">Videollamada de Telegram</string>
    <string name="tile_tg_hint">El número debe estar en contactos, con Telegram activo y «Sincronizar contactos» activado en Telegram (Ajustes › Privacidad).</string>
    <string name="tile_tg_not_found">Telegram aún no tiene la videollamada para este número: comprueba que esté en contactos, que use Telegram y que «Sincronizar contactos» esté activado en Telegram. Mientras tanto, el mosaico abre el chat.</string>
    <string name="launch_no_telegram">Telegram no está instalado</string>
    <string name="launch_telegram_chat">Videollamada no disponible para este número: abro el chat de Telegram</string>
